<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/gris"
    android:id="@+id/main">

<!--Hecho en casa -->

    <TextView
        android:id="@+id/pantalla"
        android:layout_height="230dp"
        android:layout_width="0dp"
        android:background="@color/grisClaro"
        android:text="@string/mi_nombre"
        android:textColor="@color/white"
        android:textAlignment="textEnd"
        android:textSize="32sp"
        android:paddingHorizontal="17dp"
        android:paddingVertical="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />


    <Button
        android:id="@+id/b7"
        style="@style/BotonEstilo"
        android:text="@string/Cal_7"
        app:layout_constraintEnd_toStartOf="@id/b8"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pantalla"
        app:layout_constraintBottom_toTopOf="@id/b4"/>
    <Button
        android:id="@+id/b8"
        style="@style/BotonEstilo"
        android:text="@string/Cal_8"
        app:layout_constraintTop_toBottomOf="@id/pantalla"
        app:layout_constraintStart_toEndOf="@id/b7"
        app:layout_constraintEnd_toStartOf="@id/b9"
        app:layout_constraintBottom_toTopOf="@id/b4"
        />
    <Button
        android:id="@+id/b9"
        style="@style/BotonEstilo"
        android:text="@string/Cal_9"
        app:layout_constraintTop_toBottomOf="@id/pantalla"
        app:layout_constraintStart_toEndOf="@id/b8"
        app:layout_constraintEnd_toStartOf="@id/bPor"
        app:layout_constraintBottom_toTopOf="@id/b4"/>
    <Button
        android:id="@+id/bPor"
        style="@style/BotonEstilo"
        android:text="@string/xCal"
        app:layout_constraintTop_toBottomOf="@id/pantalla"
        app:layout_constraintStart_toEndOf="@id/b9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/b4"
        />



    <Button
        android:id="@+id/b4"
        style="@style/BotonEstilo"
        android:text="@string/Cal_4"
        app:layout_constraintEnd_toStartOf="@id/b5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/b7"
        app:layout_constraintBottom_toTopOf="@id/b1"/>
    <Button
        android:id="@+id/b5"
        style="@style/BotonEstilo"
        android:text="@string/Cal_5"
        app:layout_constraintTop_toBottomOf="@id/b7"
        app:layout_constraintStart_toEndOf="@id/b4"
        app:layout_constraintEnd_toStartOf="@id/b6"
        app:layout_constraintBottom_toTopOf="@id/b1"
        />
    <Button
        android:id="@+id/b6"
        style="@style/BotonEstilo"
        android:text="@string/Cal_6"
        app:layout_constraintTop_toBottomOf="@id/b7"
        app:layout_constraintStart_toEndOf="@id/b5"
        app:layout_constraintEnd_toStartOf="@id/bMenos"
        app:layout_constraintBottom_toTopOf="@id/b1"
        />
    <Button
        android:id="@+id/bMenos"
        style="@style/BotonEstilo"
        android:text="@string/MenosCal"
        app:layout_constraintTop_toBottomOf="@id/b7"
        app:layout_constraintStart_toEndOf="@id/b6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/b1"
        />



    <Button
        android:id="@+id/b1"
        style="@style/BotonEstilo"
        android:text="@string/Cal_1"
        app:layout_constraintEnd_toStartOf="@id/b2"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/b4"
        app:layout_constraintBottom_toTopOf="@id/bComa"
        />
    <Button
        android:id="@+id/b2"
        style="@style/BotonEstilo"
        android:text="@string/Cal_2"
        app:layout_constraintTop_toBottomOf="@id/b4"
        app:layout_constraintStart_toEndOf="@id/b1"
        app:layout_constraintEnd_toStartOf="@id/b3"
        app:layout_constraintBottom_toTopOf="@id/bComa"
        />
    <Button
        android:id="@+id/b3"
        style="@style/BotonEstilo"
        android:text="@string/Cal_3"
        app:layout_constraintTop_toBottomOf="@id/b4"
        app:layout_constraintStart_toEndOf="@id/b2"
        app:layout_constraintEnd_toStartOf="@id/bMas"
        app:layout_constraintBottom_toTopOf="@id/bComa"
        />

    <Button
        android:id="@+id/bMas"
        style="@style/BotonEstilo"
        android:text="@string/MasCal"
        app:layout_constraintTop_toBottomOf="@id/b4"
        app:layout_constraintStart_toEndOf="@id/b3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bComa"
        />




    <Button
        android:id="@+id/bComa"
        style="@style/BotonEstilo"
        android:text="@string/ComaCal"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintTop_toBottomOf="@id/b1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/b0"
        app:layout_constraintBottom_toBottomOf="parent"
        />
    <Button
        android:id="@+id/b0"
        style="@style/BotonEstilo"
        android:text="@string/Cal_0"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintTop_toBottomOf="@id/b1"
        app:layout_constraintStart_toEndOf="@id/bComa"
        app:layout_constraintEnd_toStartOf="@id/bIgual"
        app:layout_constraintBottom_toBottomOf="parent"
        />
    <Button
        android:id="@+id/bIgual"
        style="@style/BotonEstiloIgual"
        android:text="@string/IgualCal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintTop_toBottomOf="@id/b1"
        app:layout_constraintStart_toEndOf="@id/b0"
        app:layout_constraintEnd_toEndOf="parent" />






</androidx.constraintlayout.widget.ConstraintLayout>